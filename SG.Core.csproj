<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net40 matches the existing SG library; net48 for a modern build -->
    <TargetFrameworks>net40;net48</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>SG.Core</RootNamespace>
    <AssemblyName>SG.Core</AssemblyName>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="11.0.2" />
    <!-- lets SDK-style projects target net40 without the old targeting pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Management" />
  </ItemGroup>
</Project>
